          "docs": "Create calendar slots"
        },
        {
          "info": {
            "name": "Update calendar slot",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.fountain.com/v2/available-slots/:id",
            "params": [
              {
                "name": "id",
                "value": "",
