{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fountain Developer API (Hire API v2) Applicants Workers API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-ACCESS-TOKEN",
      "value": "{{X-ACCESS-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fountain.com/v2/workers"
          },
          "docs": "List workers"
        },
        {
          "info": {
            "name": "Get worker info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fountain.com/v2/workers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get worker info"
        },
        {
          "info": {
            "name": "Update worker",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.fountain.com/v2/workers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update worker"
        },
        {
          "info": {
            "name": "Activate worker",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fountain.com/v2/workers/:id/activate",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Activate worker"
        },
        {
          "info": {
            "name": "Deactivate worker",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fountain.com/v2/workers/:id/deactivate",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deactivate worker"
        }
      ]
    }
  ],
  "bundled": true
}